RF_USER_ID=
RF_USER_TOKEN=
# 可選：自動登入同一採集帳號。帳密只填 Oracle .env，不可提交或放到前端。
RF_LOGIN_EMAIL=
RF_LOGIN_PASSWORD=
RF_APP_VERSION=2.28
# 可選：必須是採集帳號實際加入的聯盟 ID；留空不查詢內部戰力／報到人數。
RF_UNION_ID=
RF_SOCKET_URL=wss://api.komisureiya.com/socket
RF_LOCALE=zh_TW
HOST=127.0.0.1
PORT=8787
# Oracle 歷史封存目錄；留空使用專案內 .data/history-archives，不自動清理舊日期。
RF_ARCHIVE_DIR=
PUBLIC_ORIGIN=https://chiaomao666.github.io
# 只在雲端主機設定，絕不可放進網頁或 GitHub。
SUPABASE_URL=https://bfecoizruicaaqxhmyqn.supabase.co
SUPABASE_WRITE_KEY=
